# Copy this file to application-secrets.properties and replace the values.
# Set true only when intentionally provisioning the initial administrator.
app.admin.bootstrap.enabled=false
app.admin.email=
app.admin.password=

# Optional local simulation key: use a private random value of at least 32 bytes.
# Leave blank to use an unknown per-process key (manual webhook simulation then unavailable).
app.payment.mock.webhook-secret=